DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracehire?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Google OAuth (optional but supported in v0.5)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI: deterministic heuristic mode is the default. Set provider + key/model to enable the optional adapter.
AI_PROVIDER="heuristic"
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Optional provider-agnostic transactional email webhook. If blank, messages remain in the DB outbox.
EMAIL_WEBHOOK_URL=""

# Development filesystem adapter. Replace with object storage for multi-instance production deployment.
RESUME_STORAGE_DIR=".tracehire-data/resumes"

# Only enable when the deployment is behind a trusted reverse proxy/load balancer that overwrites these headers.
TRUST_PROXY_HEADERS="false"
AI_FALLBACK_TO_HEURISTIC="true"

# Recommended separate key for encrypting TOTP secrets at rest. If omitted, JWT_SECRET is used as key material.
TWO_FACTOR_ENCRYPTION_KEY="replace-with-a-separate-32-plus-character-random-secret"

# Keep false/undefined in real production. Only enable for a disposable demo database.
ALLOW_DESTRUCTIVE_DEMO_SEED="false"
