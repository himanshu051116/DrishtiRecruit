{
  "name": "drishti-recruit",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:core": "vitest run tests/decisionCoverage.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "qa:static": "node scripts/static-qa.mjs",
    "submission:preflight": "node scripts/submission-preflight.mjs",
    "demo:reset": "tsx prisma/seed.ts",
    "qa:source": "node scripts/source-integrity.mjs",
    "qa:release": "npm run qa:static && npm run qa:source && npm run qa:pdf && npm run submission:preflight",
    "qa:pdf": "node --experimental-strip-types scripts/pdf-smoke.mjs",
    "runtime:preflight": "node scripts/runtime-preflight.mjs",
    "qa:browser": "node scripts/browser-role-qa.mjs",
    "runtime:acceptance": "node scripts/runtime-acceptance.mjs",
    "runtime:acceptance:full": "node scripts/runtime-acceptance.mjs --db --seed --browser"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.13",
    "next": "16.2.11",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "dotenv": "^17.4.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
